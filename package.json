{
  "name": "dwarfium",
  "version": "3.1.8",
  "private": true,
  "pkg": {
    "scripts": [
      "./server/server.js",
      "./node_modules/express/**/*",
      "./node_modules/cors/**/*"
    ]
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:tauri": "next dev",
    "dev:windows": "concurrently \"cd ./install/windows && mediamtx.exe ..\\config\\mediamtx.yml\" \"npm run dev\"",
    "dev:linux": "concurrently \"cd ./install/linux && ./mediamtx ../config/mediamtx.yml\" \"npm run dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./cert/DwarfiumKey.pem --experimental-https-cert ./cert/DwarfiumCert.pem",
    "build": "next build",
    "build:api": "cross-env NEXT_PUBLIC_URL_PROXY_CORS=/api/proxy next build",
    "start:api": "cross-env NEXT_PUBLIC_URL_PROXY_CORS=/api/proxy next start",
    "start:windows": "concurrently \"cd ./install/windows && mediamtx.exe ..\\config\\mediamtx.yml\" \"npm run start:api\"",
    "start:linux": "concurrently \"cd ./install/linux && ./mediamtx ../config/mediamtx.yml\" \"npm run start:api\"",
    "start:macos": "concurrently \"cd ./install/macos && ./mediamtx ../config/mediamtx.yml\" \"npm run start:api\"",
    "build:server": "npx tsx ./server/build-server.ts  && npx tsx ./server/build-SSLcert.ts",
    "package:server": "node ./scripts/package-server.js",
    "copy:tools": "node ./scripts/copy-tools.js",
    "build:mediamtx": "node ./scripts/build-mediamtx.js",
    "postbuild": "npm run build:server && npm run package:server && npm run copy:tools",
    "tauri": "node scripts/set-version.js && tauri",
    "zipsite": "npm run build && npm run prepare:dist && tar -czvf Dwarfium.tar.gz Dwarfium && rm -rf Dwarfium",
    "zipsite:win": "npm run build && npm run prepare:dist && powershell -Command \"Compress-Archive -Path Dwarfium -DestinationPath Dwarfium.zip; Remove-Item -Recurse -Force Dwarfium\"",
    "zipsite:wsl": "cross-env NEXT_PUBLIC_URL_PROXY_CORS=http://$(hostname -I):8860,NEXT_PUBLIC_IP_MEDIAMTX=$(hostname -I) npm run build && npm run prepare:dist && tar -czvf Dwarfium.tar.gz Dwarfium && rm -rf Dwarfium",
    "ziptools:win": "npm run postbuild && npm run prepare:tools && powershell -Command \"Compress-Archive -Path DwarfiumProxy -DestinationPath DwarfiumProxy.zip; Remove-Item -Recurse -Force DwarfiumProxy\"",
    "zipserver:win": "npm run build && npm run prepare:server && powershell -Command \"Compress-Archive -Path DwarfiumServer -DestinationPath DwarfiumServer.zip; Remove-Item -Recurse -Force DwarfiumServer\"",
    "prepare:dist": "node scripts/prepareDist.js",
    "prepare:tools": "node scripts/prepareProxy.js",
    "prepare:server": "node scripts/prepareServer.js",
    "certificate": "npx tsx ./server/createSSLcert.ts \"./cert\" ",
    "lint": "eslint src server/*.ts",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\" \"server/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\" \"server/*.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "CI": "npm run lint && npm run format && npm run typecheck && npm run test",
    "test": "cross-env TZ=Europe/Berlin jest",
    "test:watch": "cross-env TZ=Europe/Berlin jest . --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@reduxjs/toolkit": "^2.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/dom-serial": "^1.0.6",
    "@types/node": "20.2.1",
    "@types/pem": "^1.14.4",
    "@types/react": "^18.2.25",
    "@types/react-dom": "18.2.4",
    "@types/web-bluetooth": "^0.0.20",
    "aladin-lite": "^3.3.2",
    "astronomia": "^4.1.1",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.2",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dwarfii_api": "github:acocalypso/dwarfii_api#45cdb3f87df4ce4865ae07688227dd983bf3f04e",
    "esbuild": "^0.25.0",
    "express": "^4.21.1",
    "fabric": "7.4.0",
    "fitsjs": "^0.6.6",
    "formik": "^2.4.2",
    "i18next": "^23.11.2",
    "joystick-controller": "1.0.15",
    "lucide-react": "^0.479.0",
    "lunarphase-js": "^2.0.3",
    "next": "^16.3.5",
    "next-redux-wrapper": "^8.1.0",
    "node-forge": "^1.3.1",
    "papaparse": "^5.4.1",
    "prettier": "^3.9.8",
    "react": "18.2.0",
    "react-bootstrap": "^2.7.4",
    "react-chartjs-2": "^5.2.0",
    "react-date-picker": "^8.2.0",
    "react-datepicker": "^4.1.1",
    "react-dom": "18.2.0",
    "react-draggable": "^4.4.6",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^14.1.1",
    "react-redux": "^9.1.0",
    "react-resizable": "^3.0.5",
    "react-sliding-pane": "^7.3.0",
    "react-zoom-pan-pinch": "^3.1.0",
    "rss-parser": "^3.13.0",
    "suncalc": "^1.9.0",
    "tsx": "^4.19.2",
    "undici": "^7.29.1",
    "unzipper": "^0.12.3",
    "utif": "^3.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/papaparse": "^5.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "typescript": "^5.0.4"
  },
  "description": "![GitHub issues](https://img.shields.io/github/issues/stevejcl/dwarfii-stellarium-goto)\r ![GitHub last commit](https://img.shields.io/github/last-commit/stevejcl/dwarfii-stellarium-goto)\r ![GitHub](https://img.shields.io/github/license/stevejcl/dwarfii-stellarium-goto)\r ![downloads](https://img.shields.io/github/downloads/stevejcl/dwarfii-stellarium-goto/total.svg)\r [![Discord](https://dcbadge.vercel.app/api/server/5vFWbsXDfv)](https://discord.gg/5vFWbsXDfv)\r ![Repobeats](https://repobeats.axiom.co/api/embed/14963aa4fc5307591a6e387817c1dedf75d7e8f9.svg \"Repobeats analytics image\")",
  "main": "next.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "glob": "13.0.6",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "rimraf": "5.0.7",
    "tar": "7.5.22"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "canvas@3.2.3": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "core-js": false,
    "protobufjs": false
  }
}
