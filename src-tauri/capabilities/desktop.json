{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Minimal permissions required by the Dwarfium desktop shell",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/DwarfiumProxy",
          "sidecar": true,
          "args": false
        },
        {
          "name": "bin/mediamtx",
          "sidecar": true,
          "args": [
            {
              "validator": "\\S+"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/DwarfiumProxy",
          "sidecar": true,
          "args": false
        },
        {
          "name": "bin/mediamtx",
          "sidecar": true,
          "args": [
            {
              "validator": "\\S+"
            }
          ]
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
